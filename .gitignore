# Dependencies
node_modules/
**/node_modules/

# Environment & credentials — NEVER commit these
.env
.env.local
.env.*.local
server/.env

# ALIS credentials / session storage
server/auth/
server/.alis-session/
*.session.json
credentials.json

# Database (contains project history / logs — local only)
server/db/*.sqlite
server/db/*.db
*.sqlite
*.db

# Playwright artifacts
server/automation/screenshots/
server/automation/traces/
test-results/
playwright-report/

# Raw KPI-export API pulls (resident-level data — cache only, never commit)
server/automation/kpi-cache/

# Resident Acuity History job output (resident names, care levels, fees — never commit)
server/automation/acuity-reports/

# Portfolio-wide CRM ID Audit workbooks — generated job output, never commit
server/automation/crm-id-audit-bulk-reports/

# Stray raw resident-level data dumps at the server root (e.g. one-off
# recon pulls like community139_care_mar_aug.json — residentId/careDate/
# careItem rows) — never commit, same reasoning as kpi-cache/ above.
server/community*_care_*.json

# Build output
client/dist/
client/build/

# Logs
logs/
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
