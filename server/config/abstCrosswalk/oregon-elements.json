{
  "_readme": "Editable crosswalk: Oregon ABST care elements (OAR 411-054-0037(3)) -> RET questions and ABST care item name prefixes. Questions are matched by DOMAIN + QUESTION TEXT (leading numbers like '9.' are ignored, because ALIS renumbers questions between RET versions). 'match' is 'equals' (default) or 'startsWith'. Care items are matched when the item is ABST-labeled in the Care Settings catalog and its name starts with one of the careItemPrefixes (case-insensitive). Edit freely; no code change needed.",
  "retName": "Leisure Care Assessment - Oregon",
  "elements": [
    { "id": 1, "name": "Personal hygiene",
      "questions": [ { "domain": "ADLs", "text": "Hygiene" } ],
      "careItemPrefixes": ["Hygiene", "Denture Care"] },
    { "id": 2, "name": "Grooming",
      "questions": [ { "domain": "ADLs", "text": "Grooming" } ],
      "careItemPrefixes": ["Grooming", "Shaving"] },
    { "id": 3, "name": "Dressing and undressing",
      "questions": [ { "domain": "ADLs", "text": "Dressing" } ],
      "careItemPrefixes": ["Dressing"] },
    { "id": 4, "name": "Toileting, bowel and bladder management",
      "questions": [ { "domain": "ADLs", "text": "Toileting / Incontinence Management" } ],
      "careItemPrefixes": ["Toileting"] },
    { "id": 5, "name": "Bathing",
      "questions": [
        { "domain": "ADLs", "text": "Bathing/Showering Frequency" },
        { "domain": "ADLs", "text": "Bathing/Showering - ", "match": "startsWith" },
        { "domain": "ADLs", "text": "Bathing Preferences" } ],
      "careItemPrefixes": ["Bathing"] },
    { "id": 6, "name": "Transfers",
      "questions": [ { "domain": "Mobility and Transfers", "text": "Transfers" } ],
      "careItemPrefixes": ["Transfers"] },
    { "id": 7, "name": "Repositioning",
      "questions": [ { "domain": "Mobility and Transfers", "text": "Repositioning" } ],
      "careItemPrefixes": ["Repositioning"] },
    { "id": 8, "name": "Ambulation",
      "questions": [ { "domain": "Mobility and Transfers", "text": "Ambulation" } ],
      "careItemPrefixes": ["Ambulation"] },
    { "id": 9, "name": "Supervision, cueing or support while eating",
      "questions": [
        { "domain": "Diet and Nutrition", "text": "Dining" },
        { "domain": "Diet and Nutrition", "text": "Dining Supervision Requirements" },
        { "domain": "Diet and Nutrition", "text": "Meal Escorts / Meal Tray Delivery" } ],
      "careItemPrefixes": ["Dining", "Hydration/Nutrition"] },
    { "id": 10, "name": "Medication administration",
      "questions": [
        { "domain": "Medication Assistance", "text": "Prescription, Herbal, and/or Over the Counter Medications" },
        { "domain": "Medication Assistance", "text": "Oral Medications" },
        { "domain": "Medication Assistance", "text": "Inhalers (MDI and nasal sprays)" },
        { "domain": "Medication Assistance", "text": "Topical Medications" },
        { "domain": "Medication Assistance", "text": "Medication Drops" },
        { "domain": "Medication Assistance", "text": "Insulin Injections" } ],
      "careItemPrefixes": ["Oral Medications", "Inhaler", "Topical Meds", "Drops", "Insulin Injections"] },
    { "id": 11, "name": "Non-drug interventions for pain",
      "questions": [ { "domain": "Medication Assistance", "text": "Non-Pharmacological Interventions for Pain Management" } ],
      "careItemPrefixes": ["Non-Drug Pain"] },
    { "id": 12, "name": "Providing treatments",
      "questions": [
        { "domain": "ADLs", "text": "Indicate level of assistance needed with wound care" },
        { "domain": "ADLs", "text": "Catheter Care" },
        { "domain": "ADLs", "text": "Ostomy / Ileostomy Care" },
        { "domain": "Medication Assistance", "text": "Breathing Treatments" },
        { "domain": "Medication Assistance", "text": "Oxygen Therapy" },
        { "domain": "ADLs", "text": "Wound Care" } ],
      "subTypes": [
        { "name": "Wound care", "questionIndexes": [0, 5], "prefixes": ["Wound Care", "Wound Observation"] },
        { "name": "Catheter care", "prefixes": ["Catheter Care"] },
        { "name": "Ostomy care", "prefixes": ["Ostomy"] },
        { "name": "Breathing / nebulizer treatments", "prefixes": ["Breathing Treatments"] },
        { "name": "Oxygen", "prefixes": ["Oxygen"] } ] },
    { "id": 13, "name": "Cueing or redirecting (cognitive impairment)",
      "questions": [ { "domain": "Safety and Risk", "text": "Cognition / Orientation" } ],
      "careItemPrefixes": ["Redirection and Reasoning"] },
    { "id": 14, "name": "Non-drug interventions for behaviors",
      "questions": [ { "domain": "Safety and Risk", "text": "Non-Drug Interventions for Behaviors" } ],
      "careItemPrefixes": ["Non-Drug Interventions for Behaviors"] },
    { "id": 15, "name": "Leisure, social and recreational activities",
      "questions": [ { "domain": "Activities: Social & Recreational", "text": "Activity Participation" } ],
      "careItemPrefixes": ["Activity Participation"] },
    { "id": 16, "name": "Monitoring physical conditions",
