      "careItemPrefixes": ["Fall Risk Safety Checks", "Wellness Checks", "Safety Check"] },
    { "id": 21, "name": "Resident-specific housekeeping or laundry",
      "questions": [ { "domain": "Housekeeping", "text": "Additional personal laundry, linen laundry, and housekeeping" } ],
      "careItemPrefixes": ["Additional Housekeeping", "Additional Linen", "Additional Personal Laundry", "Personal Laundry", "Bed Making", "Trash Removal"] },
    { "id": 22, "name": "Additional care services (pet care, smoking)",
      "questions": [
        { "domain": "Additional Services", "text": "Pet Care Assistance" },
        { "domain": "Smoking Assessment", "text": "Smoking Level of Assistance" } ],
      "careItemPrefixes": ["Pet Care", "Smoking"] }
  ]
