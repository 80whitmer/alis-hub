    { "id": 17, "name": "Monitoring behavioral conditions",
      "questions": [ { "domain": "General Information", "text": "Monitoring Behavioral Conditions or Symptoms" } ],
      "careItemPrefixes": ["Behavioral Conditions Monitoring"] },
    { "id": 18, "name": "Communication and assistive devices",
      "questions": [ { "domain": "Safety and Risk", "text": "Communication" } ],
      "careItemPrefixes": ["Communication Assistance", "Glasses", "Hearing Aid"] },
    { "id": 19, "name": "Responding to call lights",
      "questions": [
        { "domain": "Safety and Risk", "text": "Does the resident use a call pendant or have a call light system?" },
