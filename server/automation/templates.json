{
  "templates": [
    {
      "id": "create-communities",
      "name": "Create Communities",
      "description": "Provision communities in ALIS with licensed capacity and address information",
      "category": "provisioning",
      "icon": "🏢",
      "timeout": 3600000,
      "scriptPath": "./create-communities.js",
      "inputSchema": {
        "type": "object",
        "title": "Create Communities",
        "properties": {
          "companyUrl": {
            "type": "string",
            "title": "Company Admin URL",
            "description": "Full URL to the company page in ALIS admin",
            "examples": ["https://admin.alisonline.com/Customers/Companies/770"]
          },
          "communities": {
            "type": "array",
            "title": "Communities",
            "description": "List of communities to create",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Community Name",
                  "examples": ["Steadman Hill"]
                },
                "crm_id": {
                  "type": "string",
                  "title": "CRM ID",
                  "examples": ["12345678901"]
                },
                "licensed_capacity": {
                  "type": "string",
                  "title": "Licensed Capacity",
                  "examples": ["60"]
                },
                "physical_capacity": {
                  "type": "string",
                  "title": "Physical Capacity",
                  "examples": ["60"]
                },
                "street": {
                  "type": "string",
                  "title": "Street Address",
                  "examples": ["123 Main St"]
                },
                "city": {
                  "type": "string",
                  "title": "City",
                  "examples": ["Atlanta"]
                },
                "state": {
                  "type": "string",
                  "title": "State",
                  "examples": ["GA"]
                },
                "zip": {
                  "type": "string",
                  "title": "ZIP Code",
                  "examples": ["30301"]
                },
                "flags": {
                  "type": "array",
                  "title": "Flags",
                  "items": { "type": "string" }
                }
              },
              "required": ["name", "crm_id", "licensed_capacity", "physical_capacity", "street", "city", "state", "zip"]
            }
          }
        },
        "required": ["companyUrl", "communities"]
      }
    },
    {
      "id": "sync-resident-settings",
      "name": "Sync Resident Settings",
      "description": "Copy resident settings (checkboxes, dropdowns, and compliance template properties) from a source community to one or more target communities",
      "category": "settings",
      "icon": "⚙️",
      "timeout": 3600000,
      "inputSchema": {
        "type": "object",
        "title": "Sync Resident Settings",
        "properties": {
          "sourceName": {
            "type": "string",
            "title": "Source Community Name",
            "description": "Display name of the community to copy settings FROM",
            "examples": ["Meadow Brook"]
          },
          "sourceUrl": {
            "type": "string",
            "title": "Source Resident Settings URL",
            "description": "Full URL of the Resident settings page to copy from",
            "examples": ["https://medtelligent.alisonline.com/Settings/Resident/847"]
          },
          "targets": {
            "type": "array",
            "title": "Target Communities",
            "description": "Communities to apply the settings TO",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Community Name",
                  "examples": ["Sunrise Gardens"]
                },
                "url": {
                  "type": "string",
                  "title": "Resident Settings URL",
                  "examples": ["https://medtelligent.alisonline.com/Settings/Resident/902"]
                }
              },
              "required": ["name", "url"]
            }
          }
        },
        "required": ["sourceName", "sourceUrl", "targets"]
      }
    },
    {
      "id": "sync-gl-accounts",
      "name": "Sync GL Accounts",
      "description": "Synchronize GL accounts and discount accounts for ownership transitions and account restructuring",
      "category": "billing",
      "icon": "💰",
      "timeout": 1800000,
      "scriptPath": "./sync_alis_gl_accounts.js",
      "inputSchema": {
        "type": "object",
        "title": "Sync GL Accounts",
        "properties": {
          "communityName": {
            "type": "string",
            "title": "Community Name",
            "description": "Display name of the community",
            "examples": ["Steadman Hill"]
          },
          "billingSettingsUrl": {
            "type": "string",
            "title": "Billing Settings URL",
            "description": "Full URL to the billing settings page",
            "examples": ["https://surpass.alisonline.com/Settings/Billing/1069?tab=private"]
          },
          "syncDate": {
            "type": "string",
            "title": "Sync Date",
            "description": "Date when changes take effect (MM/DD/YYYY)",
            "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
            "examples": ["05/01/2026"]
          },
          "items": {
            "type": "array",
            "title": "Billing Items",
            "description": "Billing items and their GL account mappings",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Billing Item Name",
                  "examples": ["Assisted Living Apartment Rent"]
                },
                "gl_old": {
                  "type": "string",
                  "title": "Current GL Account",
                  "examples": ["40031"]
                },
                "gl_new": {
                  "type": "string",
                  "title": "New GL Account",
                  "examples": ["400-10"]
                },
                "disc1_old": {
                  "type": "string",
                  "title": "Current Discount GL Account 1 (Optional)",
                  "examples": ["41100"]
                },
                "disc1_new": {
                  "type": "string",
                  "title": "New Discount GL Account 1 (Optional)",
                  "examples": ["440-01"]
                },
                "disc2_old": {
                  "type": "string",
                  "title": "Current Discount GL Account 2 (Optional)",
                  "examples": ["41200"]
                },
                "disc2_new": {
                  "type": "string",
                  "title": "New Discount GL Account 2 (Optional)",
                  "examples": ["440-02"]
                }
              },
              "required": ["name", "gl_old", "gl_new"]
            }
          }
        },
        "required": ["communityName", "billingSettingsUrl", "syncDate", "items"]
      }
    },
    {
      "id": "kpi-export",
      "name": "KPI Export / QBR Pipeline",
      "description": "Pull KPI data from the ALIS export API, benchmark against ALIS 500, pull HubSpot ticket history, and generate QBR discussion-point flags",
      "category": "reporting",
      "icon": "📊",
      "timeout": 1800000,
      "scriptPath": "./kpiExport.js",
      "inputSchema": {
        "type": "object",
        "title": "KPI Export / QBR Pipeline",
        "properties": {
          "companyName": {
            "type": "string",
            "title": "Company / Account Name",
            "examples": ["Viva Senior Living"]
          },
          "companyHost": {
            "type": "string",
            "title": "ALIS Company Host (subdomain)",
            "description": "The subdomain root of this company's ALIS admin URL (e.g. \"viva\" for viva.alisonline.com) — used to build the export API auth username",
            "examples": ["viva"]
          },
          "communities": {
            "type": "array",
            "title": "Communities (optional)",
            "description": "Leave empty to automatically pull every community for this account, excluding any with \"Training\" in the name",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Community Name",
                  "examples": ["Steadman Hill"]
                },
                "communityId": {
                  "type": "string",
                  "title": "ALIS Community ID",
                  "examples": ["1069"]
                }
              },
              "required": ["name", "communityId"]
            }
          },
          "periodStart": {
            "type": "string",
            "title": "Period Start (YYYY-MM-DD)",
            "examples": ["2026-04-01"]
          },
          "periodEnd": {
            "type": "string",
            "title": "Period End (YYYY-MM-DD)",
            "examples": ["2026-06-30"]
          },
          "hubspotCompanyId": {
            "type": "string",
            "title": "HubSpot Company ID (optional)",
            "description": "Links this KPI pull to the account's HubSpot ticket history for Support Review / Enhancement Requests",
            "examples": ["770"]
          }
        },
        "required": ["companyName", "companyHost", "periodStart", "periodEnd"]
      }
    }
  ]
}
