# Copy this file to server/.env and fill in your values
# NEVER commit .env to git

# ALIS Admin credentials
ALIS_USERNAME=
ALIS_PASSWORD=

# HubSpot API (for syncing automation templates & configs)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# Server config
PORT=3000
NODE_ENV=development

# Optional: set to "true" to show browser during automation (useful for debugging)
PLAYWRIGHT_HEADED=false

# Git & Deployment
GITHUB_TOKEN=
DEPLOYMENT_ENV=development
