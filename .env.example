# Copy this file to server/.env and fill in your values
# NEVER commit .env to git

# ALIS Admin credentials
ALIS_USERNAME=
ALIS_PASSWORD=

# HubSpot API (for syncing automation templates & configs, and pulling account tickets)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# Your HubSpot user/owner ID — scopes Account Health and Team AM to your own
# book ("personally closed" ARR, etc). Find it in HubSpot under Settings >
# Account Management > Users & Teams, click your name — it's the number in
# the URL. Without this set, getOwnerId() falls back to an owners.read API
# lookup by HUBSPOT_OWNER_EMAIL, which needs that scope on the private app.
HUBSPOT_OWNER_ID=
HUBSPOT_OWNER_EMAIL=

# ALIS Export API (api.alisonline.com) — used by the KPI export / QBR pipeline.
# Basic Auth username is built per-company as "<base>@<companyHost>" (e.g.
# aaron.whitmer@viva for viva.alisonline.com) — set the local-username part
# here. Password reuses ALIS_PASSWORD above; there's no separate one.
ALIS_EXPORT_API_USERNAME_BASE=

# Server config
PORT=3000
NODE_ENV=development

# Optional: set to "true" to show browser during automation (useful for debugging)
PLAYWRIGHT_HEADED=false

# Git & Deployment
GITHUB_TOKEN=
DEPLOYMENT_ENV=development
